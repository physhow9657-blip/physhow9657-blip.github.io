---
import { config } from '../config';
import { CATEGORIES } from '../lib/categories';
import { withBase, categoryUrl } from '../lib/url';

const year = new Date().getFullYear();
const showSince = config.since !== year ? `${config.since}–${year}` : `${year}`;
---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="site-footer__grid">
      <div>
        <a class="brand" href={withBase('/')}>
          <span class="brand__mark" aria-hidden="true">AC</span>
          <span>{config.name}</span>
        </a>
        <p style="margin-top:0.7rem; max-width:34ch;">{config.description}</p>
      </div>

      <div>
        <h2>카테고리</h2>
        <ul>
          {
            CATEGORIES.map((category) => (
              <li>
                <a href={categoryUrl(category.slug)}>{category.label}</a>
              </li>
            ))
          }
          <li><a href={withBase(config.tools.carTaxCalculator)}>취등록세 계산기</a></li>
        </ul>
      </div>

      <div>
        <h2>사이트</h2>
        <ul>
          <li><a href={withBase('/about/')}>운영자 소개</a></li>
          <li><a href={withBase('/contact/')}>문의·제휴</a></li>
          <li><a href={withBase('/privacy/')}>개인정보처리방침</a></li>
          <li><a href={withBase('/rss.xml')}>RSS 구독</a></li>
          <li><a href={withBase('/sitemap-index.xml')}>사이트맵</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p style="margin:0;">
        © {showSince} {config.name}. 모든 글은 공개 자료와 실제 견적을 바탕으로 작성합니다.
      </p>
      <p style="margin:0;">
        세율·보험료·정비비는 기준일 이후 바뀔 수 있습니다. 계약·신고 전 관할 기관에 확인하세요.
      </p>
    </div>
  </div>
</footer>
