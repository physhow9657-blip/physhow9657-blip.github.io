---
import { config } from '../config';
import { withBase } from '../lib/url';

const pathname = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const current = base && pathname.startsWith(base) ? pathname.slice(base.length) : pathname;

const links = [
  { href: withBase('/posts/'), label: '전체 글', match: '/posts' },
  { href: withBase(config.tools.carTaxCalculator), label: '취등록세 계산기', match: '/tools', calc: true },
  { href: withBase('/about/'), label: '소개', match: '/about' },
  { href: withBase('/contact/'), label: '문의', match: '/contact' },
];

function isCurrent(match: string) {
  return current === match || current.startsWith(`${match}/`);
}
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand__mark" aria-hidden="true">AC</span>
      <span>{config.name}</span>
    </a>
    <nav class="nav" aria-label="주요 메뉴">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={link.calc ? 'nav__calc' : undefined}
            aria-current={isCurrent(link.match) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
