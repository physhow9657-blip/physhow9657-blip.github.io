---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBox from '../../components/CtaBox.astro';
import InstaBox from '../../components/InstaBox.astro';
import AffiliateBox from '../../components/AffiliateBox.astro';
import { config } from '../../config';
import { withBase } from '../../lib/url';
import { calculateCarTax } from '../../lib/car-tax';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/published';

// 기본값(아반떼 1,598cc · 1,500만원 · 서울 이전)으로 서버에서 한 번 계산해 둡니다.
// → 자바스크립트가 늦게 로드되어도 숫자가 바로 보이고, 검색엔진도 내용을 읽을 수 있습니다.
const initialResult = calculateCarTax({
  price: 15000000,
  marketValue: 0,
  vehicle: 'passenger' as const,
  cc: 1598,
  fuel: 'ice' as const,
  registrationType: 'transfer' as const,
  region: 'seoul' as const,
  discountRate: 6.5,
  extra: 0,
});
const krwFmt = new Intl.NumberFormat('ko-KR');

const posts = (
  await getCollection('posts', isPublished)
)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const faq = [
  {
    q: '중고차 취득세는 차량 가격 그대로 7%인가요?',
    a: '과세표준은 신고한 거래가와 시가표준액 중 높은 금액입니다. 시세보다 싸게 적으면 시가표준액으로 계산되어 세금이 더 나올 수 있고, 허위 신고는 가산세 대상입니다.',
  },
  {
    q: '경차는 정말 취득세가 0원인가요?',
    a: '경형(1,000cc 미만) 승용은 세율 4%에 75만원 공제가 적용되어, 과세표준 1,875만원 이하이면 취득세가 0원입니다. 공제는 2027년 12월 31일까지 적용됩니다.',
  },
  {
    q: '전기차 감면은 언제까지인가요?',
    a: '전기차 취득세 140만원 공제는 2026년 12월 31일 취득분까지입니다. 수소차는 2027년 12월 31일, 수소 화물차는 50% 경감이 2028년 12월 31일까지입니다. 하이브리드 감면은 2024년 12월 31일 종료되었습니다.',
  },
  {
    q: '공채(채권)는 꼭 사야 하나요?',
    a: '1,600cc 미만 비영업용 승용차는 이전등록 시 매입이 면제됩니다. 그 이상 배기량은 지역 조례에 따라 과세표준의 4~6%를 매입하고, 대부분 즉시 매도해 할인 차액만 부담합니다.',
  },
  {
    q: '이전등록은 며칠 안에 해야 하나요?',
    a: '매수일(잔금일)부터 15일 이내에 이전등록을 신청해야 합니다. 넘기면 10만원에서 시작해 하루 1만원씩 늘어 최대 50만원의 과태료가 부과됩니다.',
  },
];

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: '중고차 취등록세·이전등록 비용 계산기',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  inLanguage: 'ko-KR',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  url: `${(Astro.site ?? new URL(config.url)).toString().replace(/\/+$/, '')}${withBase(config.tools.carTaxCalculator)}`,
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title="중고차 취등록세 계산기 (2026) — 이전등록 총비용"
  description="차량가·배기량·지역만 넣으면 취득세 7%, 경차 75만원 공제, 전기차 140만원 감면, 공채 할인, 등록면허세까지 이전등록 총비용을 바로 계산합니다. 가입 없이 무료."
  jsonLd={[appLd, faqLd]}
>
  <header class="page-head">
    <div class="container">
      <p class="breadcrumb" style="margin-bottom:0.5rem;"><a href={withBase('/')}>홈</a> / 계산기</p>
      <h1>중고차 취등록세 · 이전등록 총비용 계산기</h1>
      <p>
        차량 가격만 보고 계약하면 등록비에서 예산이 새어 나갑니다. 아래 4가지만 넣으면
        <strong> 취득세 + 공채 할인 + 등록면허세</strong>를 한 번에 계산합니다. (2026년 11월 기준)
      </p>
    </div>
  </header>

  <div class="container section">
    <form class="calc" id="tax-calc" autocomplete="off">
      <fieldset>
        <legend>1. 차량</legend>
        <div class="row row--2">
          <div>
            <label for="price">차량 가격 (거래가, 원)</label>
            <input type="text" id="price" inputmode="numeric" value="15,000,000" />
            <p class="hint">중고차는 매매계약서상 금액. 시가표준액보다 낮으면 시가표준액으로 계산됩니다.</p>
          </div>
          <div>
            <label for="market">시가표준액 (모르면 비워두세요)</label>
            <input type="text" id="market" inputmode="numeric" value="" placeholder="예: 18,000,000" />
            <p class="hint">차량등록사업소·위택스에서 조회할 수 있습니다.</p>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>2. 차종·연료</legend>
        <div class="row row--2">
          <div>
            <label for="vehicle">차종</label>
            <select id="vehicle">
              <option value="passenger">승용 (자가용)</option>
              <option value="compact">경차 (1,000cc 미만)</option>
              <option value="van">승합 (9인승 이하)</option>
              <option value="truck">화물</option>
              <option value="moto">이륜차 (125cc 초과)</option>
            </select>
          </div>
          <div>
            <label for="cc">배기량 (cc)</label>
            <input type="number" id="cc" min="0" max="10000" step="1" value="1598" />
            <p class="hint">전기차는 0으로 두세요. 공채·경차 판정에 쓰입니다.</p>
          </div>
        </div>
        <div class="row row--2" style="margin-top:0.9rem;">
          <div>
            <label for="fuel">연료</label>
            <select id="fuel">
              <option value="ice">가솔린·디젤·LPG</option>
              <option value="hybrid">하이브리드</option>
              <option value="ev">전기</option>
              <option value="hydrogen">수소</option>
            </select>
          </div>
          <div>
            <label for="regType">등록 구분</label>
            <select id="regType">
              <option value="transfer">이전등록 (중고차)</option>
              <option value="new">신규등록 (신차)</option>
            </select>
          </div>
        </div>
      </fieldset>

      <fieldset>
        <legend>3. 지역·부대비용</legend>
        <div class="row row--2">
          <div>
            <label for="region">등록 지역 (채권 조례)</label>
            <select id="region">
              <option value="seoul">서울</option>
              <option value="busan">부산</option>
              <option value="gyeonggi">경기</option>
              <option value="other">그 외 지자체 (직접 입력)</option>
            </select>
          </div>
          <div>
            <label for="bondRate">공채 매입률 (%) — 직접 입력</label>
            <input type="number" id="bondRate" min="0" max="30" step="0.5" value="4" disabled />
            <p class="hint">'그 외 지자체'를 고르면 직접 입력할 수 있습니다. 조례는 매년 바뀝니다.</p>
          </div>
        </div>
        <div class="row row--2" style="margin-top:0.9rem;">
          <div>
            <label for="discount">공채 즉시매도 할인율 (%)</label>
            <input type="number" id="discount" min="0" max="30" step="0.1" value="6.5" />
            <p class="hint">등록 당일 은행 고시 할인율. 2026년 통상 6%대입니다.</p>
          </div>
          <div>
            <label for="extra">기타 비용 (대행료·번호판 등, 원)</label>
            <input type="text" id="extra" inputmode="numeric" value="0" />
            <p class="hint">직접 처리하면 0원. 대행 시 3~10만원 선.</p>
          </div>
        </div>
      </fieldset>

      <div class="result" id="result" aria-live="polite">
        <div class="result__total">
          <span>예상 총비용</span>
          <strong id="total">{krwFmt.format(initialResult.total)}원</strong>
        </div>
        <table>
          <tbody id="breakdown">
            {
              initialResult.lines.map((line) => (
                <tr>
                  <th scope="row" style="border:0;padding:0.45rem 0.2rem;background:none;font-weight:600;color:var(--ink);white-space:normal;">
                    {line.label}
                    <br />
                    <span style="font-weight:400;font-size:0.8125rem;color:var(--muted);">{line.note}</span>
                  </th>
                  <td>{line.amount < 0 ? '−' : ''}{krwFmt.format(Math.abs(line.amount))}원</td>
                </tr>
              ))
            }
          </tbody>
          <tfoot id="breakdown-foot">
            <tr>
              <th scope="row" style="text-align:left;">합계</th>
              <td>{krwFmt.format(initialResult.total)}원</td>
            </tr>
          </tfoot>
        </table>
        <p class="hint" id="basis" style="margin-top:0.6rem;">{initialResult.notes.join(' ')}</p>
        <noscript>
          <p class="hint">자바스크립트를 켜면 차량가·배기량을 바꿔 직접 계산할 수 있습니다.</p>
        </noscript>
      </div>

      <div class="calc__actions">
        <button type="button" class="btn btn--sm" id="copy">결과 복사</button>
        <button type="button" class="btn btn--sm" id="reset">초기화</button>
        <a class="btn btn--sm" href={withBase('/posts/2026-used-car-registration-tax-guide/')}>계산 근거 읽기</a>
      </div>

      <div class="calc__notes">
        <strong>계산 기준</strong> — 취득세: 비영업용 승용 7%, 경형 4%(75만원 공제, 2027.12.31까지), 승합·화물 5%,
        이륜 2%. 전기 140만원 공제(2026.12.31까지), 수소 140만원(2027.12.31까지), 수소 화물 50% 경감(2028.12.31까지).
        공채: 1,600cc 미만 승용 면제, 서울 이전 6%·경기 4%(1,600~2,000cc), 부산 4%(1,600cc 이상).
        등록면허세 15,000원 + 증지·인지 등 4,000원 포함. 실제 고지액과 수천 원~수만 원 차이가 날 수 있습니다.
      </div>
    </form>

    <InstaBox keyword="계산기" />

    <AffiliateBox
      placement="mid"
      title="등록 전에 미리 사 두면 좋은 것"
      body="번호판 볼트·세차용품처럼 등록 당일 바로 쓰는 품목입니다."
      compact
    />

    <section class="faq" aria-labelledby="calc-faq">
      <h2 id="calc-faq">자주 묻는 질문</h2>
      {faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>

    <CtaBox
      title="이 계산기를 릴스에서 받아가세요"
      description="인스타에서 댓글에 '계산기'를 남기면 이 링크를 DM으로 보내드립니다. 차량가만 넣으면 바로 계산됩니다."
      buttonLabel="관련 글 읽기"
      path="/posts/2026-used-car-registration-tax-guide/"
    />

    <section style="margin-top:2.5rem;">
      <h2 style="font-size:var(--step-2);">이어서 읽으면 좋은 글</h2>
      <ul style="list-style:none;padding:0;margin:0.8rem 0 0;display:grid;gap:0.5rem;">
        {posts.map((post) => (
          <li><a href={withBase(`/posts/${post.id}/`)} style="font-weight:600;">{post.data.title}</a></li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  // ───────────────────────────────────────────────────────────────────────────
  // 계산기 화면 로직 (계산 규칙은 src/lib/car-tax.ts 에 있습니다)
  // 서버 전송 없음 · 입력값 저장 없음 — 모두 브라우저 안에서만 계산됩니다.
  // ───────────────────────────────────────────────────────────────────────────
  import { calculateCarTax, bondRatePercent } from '../../lib/car-tax';

  const krw = new Intl.NumberFormat('ko-KR');
  const el = (id) => document.getElementById(id);

  const parseNum = (value) => {
    const digits = String(value || '').replace(/[^0-9.]/g, '');
    return digits === '' ? 0 : Number(digits);
  };

  function readInputs() {
    return {
      price: parseNum(el('price').value),
      marketValue: parseNum(el('market').value),
      vehicle: el('vehicle').value,
      cc: parseNum(el('cc').value),
      fuel: el('fuel').value,
      registrationType: el('regType').value,
      region: el('region').value,
      bondRateOverride: parseNum(el('bondRate').value),
      discountRate: parseNum(el('discount').value),
      extra: parseNum(el('extra').value),
    };
  }

  function render() {
    const input = readInputs();
    const result = calculateCarTax(input);

    el('total').textContent = `${krw.format(result.total)}원`;

    el('breakdown').innerHTML = result.lines
      .map(
        (line) =>
          `<tr><th scope="row" style="border:0;padding:0.45rem 0.2rem;background:none;font-weight:600;color:var(--ink);white-space:normal;">${line.label}<br><span style="font-weight:400;font-size:0.8125rem;color:var(--muted);">${line.note}</span></th><td>${line.amount < 0 ? '−' : ''}${krw.format(Math.abs(line.amount))}원</td></tr>`
      )
      .join('');
    el('breakdown-foot').innerHTML = `<tr><th scope="row" style="text-align:left;">합계</th><td>${krw.format(result.total)}원</td></tr>`;
    el('basis').textContent = result.notes.join(' ');
  }

  /** 지역을 고르면 그 지역 조례의 매입률을 자동으로 채웁니다. */
  function syncBondInput() {
    const bondInput = el('bondRate');
    const region = el('region').value;
    if (region === 'other') {
      bondInput.disabled = false;
      return;
    }
    bondInput.value = String(
      bondRatePercent({
        region,
        registrationType: el('regType').value,
        cc: parseNum(el('cc').value),
        vehicle: el('vehicle').value,
        fuel: el('fuel').value,
        bondRateOverride: parseNum(bondInput.value),
      })
    );
    bondInput.disabled = true;
  }

  function refresh() {
    syncBondInput();
    render();
  }

  function formatMoneyInput(input) {
    const value = parseNum(input.value);
    input.value = value === 0 && String(input.value).trim() === '' ? '' : krw.format(value);
  }

  ['price', 'market', 'extra'].forEach((id) => {
    const input = el(id);
    input.addEventListener('input', () => {
      const atEnd = input.selectionStart === input.value.length;
      formatMoneyInput(input);
      if (atEnd) input.setSelectionRange(input.value.length, input.value.length);
      render();
    });
  });

  ['vehicle', 'cc', 'fuel', 'regType', 'region', 'bondRate', 'discount'].forEach((id) => {
    const input = el(id);
    input.addEventListener('input', refresh);
    input.addEventListener('change', refresh);
  });

  // URL 파라미터 프리필 — 인스타 자동 DM 이 차량 조건을 채운 링크를 보낼 때 사용
  // 예: /tools/car-tax-calculator/?price=15000000&cc=1598&vehicle=passenger&fuel=ice&region=seoul&type=transfer
  const params = new URLSearchParams(window.location.search);
  const setIf = (id, value) => {
    if (value !== null && value !== '' && el(id)) el(id).value = value;
  };
  setIf('price', params.get('price'));
  setIf('market', params.get('market'));
  setIf('cc', params.get('cc'));
  setIf('vehicle', params.get('vehicle'));
  setIf('fuel', params.get('fuel'));
  setIf('region', params.get('region'));
  setIf('regType', params.get('type'));
  formatMoneyInput(el('price'));
  formatMoneyInput(el('market'));

  el('copy').addEventListener('click', async () => {
    const text = [
      '중고차 이전등록 예상 비용',
      `차량가: ${el('price').value}원`,
      `차종: ${el('vehicle').options[el('vehicle').selectedIndex].text}`,
      `예상 총비용: ${el('total').textContent}`,
      el('basis').textContent,
      `계산: ${window.location.href}`,
    ].join('\n');
    try {
      await navigator.clipboard.writeText(text);
      el('copy').textContent = '복사됨 ✓';
      setTimeout(() => (el('copy').textContent = '결과 복사'), 1600);
    } catch {
      el('copy').textContent = '복사 실패';
    }
  });

  el('reset').addEventListener('click', () => {
    el('price').value = '15,000,000';
    el('market').value = '';
    el('vehicle').value = 'passenger';
    el('cc').value = '1598';
    el('fuel').value = 'ice';
    el('regType').value = 'transfer';
    el('region').value = 'seoul';
    el('discount').value = '6.5';
    el('extra').value = '0';
    refresh();
  });

  refresh();
</script>
