---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { withBase } from '../lib/url';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: '문의',
  inLanguage: 'ko-KR',
};
---

<BaseLayout title="문의 · 제휴" description={`${config.name} 운영자에게 오류 제보, 자료 요청, 제휴 문의를 보내는 방법.`} jsonLd={ld}>
  <header class="page-head">
    <div class="container">
      <h1>문의</h1>
      <p>오류 제보와 자료 요청을 가장 빠르게 처리합니다.</p>
    </div>
  </header>

  <div class="container section">
    <div class="prose">
      <h2>이메일</h2>
      <p>
        <strong>{config.contact.email}</strong>
        <br />
        {config.contact.responseTime}에 답변드립니다. 제목 앞에 아래 표시를 붙여 주시면 분류가 빠릅니다.
      </p>
      <ul>
        <li><code>[오류]</code> 계산 결과나 수치가 잘못된 부분 (화면 캡처·차량 조건을 함께 보내주세요)</li>
        <li><code>[요청]</code> 다뤄줬으면 하는 차종·주제</li>
        <li><code>[제휴]</code> 협업·광고·제휴 문의 (회사명, 제안 내용, 예산 범위)</li>
        <li><code>[기타]</code> 그 외</li>
      </ul>

      <h2>답변하지 않는 것</h2>
      <ul>
        <li>개별 차량의 구매 대행·중개 (판매처 소개는 하지 않습니다)</li>
        <li>세무·법률 자문 (관할 세무서·차량등록사업소에 문의하세요)</li>
        <li>특정 판매처를 깎아내리는 내용의 제보 (사실 확인이 어려워 게재하지 않습니다)</li>
      </ul>

      <h2>자주 받는 질문</h2>
      <p>
        취등록세·이전등록 비용은 <a href={withBase(config.tools.carTaxCalculator)}>계산기</a>에서 바로
        확인할 수 있습니다. 계산 근거와 예시는
        <a href={withBase('/posts/2026-used-car-registration-tax-guide/')}>이 글</a>에 정리해 두었습니다.
      </p>

      <h2>운영자</h2>
      <p>
        {config.author.name} · {config.author.role} · {config.author.location}
        <br />
        <a href={withBase('/about/')}>소개 페이지에서 경력과 집필 기준 보기</a>
      </p>
    </div>
  </div>
</BaseLayout>
