---
import BaseLayout from '../layouts/BaseLayout.astro';
import { config } from '../config';
import { withBase } from '../lib/url';
---

<BaseLayout title="페이지를 찾을 수 없습니다 (404)" description="주소가 바뀌었거나 삭제된 글입니다." noindex>
  <div class="container section" style="text-align:center;padding-block:4rem;">
    <p style="font-size:3rem;margin:0;">🧭</p>
    <h1 style="font-size:var(--step-3);">페이지를 찾을 수 없습니다</h1>
    <p style="color:var(--muted);max-width:38ch;margin:0 auto 1.5rem;">
      주소가 바뀌었거나 삭제된 글입니다. 아래에서 다시 찾아보세요.
    </p>
    <div class="hero__actions" style="justify-content:center;">
      <a class="btn btn--primary" href={withBase('/posts/')}>글 전체 보기</a>
      <a class="btn" href={withBase(config.tools.carTaxCalculator)}>취등록세 계산기</a>
    </div>
  </div>
</BaseLayout>
