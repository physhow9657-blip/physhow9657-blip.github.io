---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { config } from '../../config';
import { CATEGORIES } from '../../lib/categories';
import { withBase } from '../../lib/url';

const posts = (await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const grouped = CATEGORIES.map((category) => ({
  category,
  posts: posts.filter((post) => post.data.category === category.id),
})).filter((group) => group.posts.length > 0);
---

<BaseLayout title="전체 글" description={`${config.name}의 모든 글 — 중고차 구매·세금·보험·유지비 데이터.`}>
  <header class="page-head">
    <div class="container">
      <h1>전체 글 ({posts.length})</h1>
      <p>구매·세금·금융, 보험·사고이력, 유지비·부품 순으로 정리했습니다.</p>
    </div>
  </header>

  <div class="container section">
    {
      grouped.length === 0 && <p class="empty">아직 발행된 글이 없습니다.</p>
    }

    {
      grouped.map(({ category, posts: categoryPosts }) => (
        <section style="margin-bottom:2.5rem;">
          <div class="section__head">
            <h2>{category.label}</h2>
            <a class="section__more" href={withBase(`/category/${category.slug}/`)}>
              모아보기 →
            </a>
          </div>
          <div class="grid grid--2">
            {categoryPosts.map((post) => <PostCard post={post} showCategory={false} />)}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
