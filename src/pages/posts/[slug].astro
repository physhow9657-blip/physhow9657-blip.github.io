---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => (import.meta.env.PROD ? !data.draft : true));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const related = await getCollection(
  'posts',
  ({ data, id }) => id !== post.id && (import.meta.env.PROD ? !data.draft : true)
);
---

<PostLayout post={post} headings={headings} related={related}>
  <Content />
</PostLayout>
