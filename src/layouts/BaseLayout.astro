---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { config } from '../config';
import { withBase } from '../lib/url';

interface Props {
  /** 페이지 제목. 사이트 이름은 자동으로 뒤에 붙습니다. */
  title: string;
  description: string;
  /** 기본값은 현재 페이지 주소. 특별한 경우에만 직접 지정하세요. */
  canonicalPath?: string;
  type?: 'website' | 'article';
  image?: string;
  noindex?: boolean;
  /** 구조화 데이터 (Article, FAQPage 등). 객체 또는 배열. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** 홈처럼 제목에 사이트명을 붙이지 않을 때 true */
  isHome?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  type = 'website',
  image,
  noindex = false,
  jsonLd,
  isHome = false,
} = Astro.props;

const siteUrl = (Astro.site ?? new URL(config.url)).toString().replace(/\/+$/, '');
const path = canonicalPath ?? Astro.url.pathname;
const canonical = `${siteUrl}${path.startsWith('/') ? path : `/${path}`}`;
const fullTitle = isHome ? title : `${title} | ${config.name}`;
const ogImage = image ? `${siteUrl}${image.startsWith('/') ? image : `/${image}`}` : undefined;

const ldBlocks = (Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []).map((block) =>
  JSON.stringify(block).replace(/</g, '\\u003c')
);

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: config.name,
  url: `${siteUrl}/`,
  inLanguage: 'ko-KR',
  description: config.description,
  publisher: {
    '@type': 'Person',
    name: config.author.name,
    jobTitle: config.author.role,
  },
};
---

<!doctype html>
<html lang={config.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="naver-site-verification" content="6718ec33bbd63831adf0fb1dec82b6c8cdf0b203" />
    <meta name="google-site-verification" content="9El19OEY2A5R9XTxfVt4eh74vY77xM5mL-BwPmiHrCY" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={config.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={config.locale} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${config.name} RSS`} href={withBase('/rss.xml')} />

    {/* 애드센스: 승인 후 config.adsense.enabled = true 로 바꾸면 자동 삽입됩니다. */}
    {
      config.adsense.enabled && (
        <>
          <meta name="google-adsense-account" content={config.adsense.client} />
          <script
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${config.adsense.client}`}
            crossorigin="anonymous"
          />
        </>
      )
    }

    <script type="application/ld+json" set:html={JSON.stringify(websiteLd).replace(/</g, '\\u003c')} />
    {ldBlocks.map((block) => <script type="application/ld+json" set:html={block} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">본문으로 바로가기</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
