---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Toc from '../components/Toc.astro';
import AdSlot from '../components/AdSlot.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import CtaBox from '../components/CtaBox.astro';
import InstaBox from '../components/InstaBox.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { config } from '../config';
import { getCategory } from '../lib/categories';
import { withBase, categoryUrl, postUrl } from '../lib/url';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: MarkdownHeading[];
  related: CollectionEntry<'posts'>[];
}

const { post, headings, related } = Astro.props;
const { data } = post;
const category = getCategory(data.category);

// 한국어 기준 분당 약 500자 읽기로 계산
const bodyLength = (post.body ?? '').replace(/\s+/g, ' ').trim().length;
const readingMinutes = Math.max(1, Math.round(bodyLength / 500));
const isFresh = Date.now() - data.pubDate.valueOf() < 1000 * 60 * 60 * 24 * 30;

const dateText = data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
const updatedText = data.updatedDate?.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const showCalculator = data.ctaType === 'calculator' || data.ctaType === 'both';
const showAffiliate = data.ctaType === 'affiliate' || data.ctaType === 'both';

const siteUrl = (Astro.site ?? new URL(config.url)).toString().replace(/\/+$/, '');

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.pubDate.toISOString(),
  dateModified: (data.updatedDate ?? data.pubDate).toISOString(),
  inLanguage: 'ko-KR',
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${siteUrl}${postUrl(post.id)}` },
  author: {
    '@type': 'Person',
    name: config.author.name,
    jobTitle: config.author.role,
    description: config.author.bio,
  },
  publisher: { '@type': 'Person', name: config.author.name },
  articleSection: category.label,
  keywords: data.tags.join(', '),
  ...(data.cover ? { image: `${siteUrl}${data.cover}` } : {}),
};

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: category.label, item: `${siteUrl}${categoryUrl(category.slug)}` },
    { '@type': 'ListItem', position: 3, name: data.title, item: `${siteUrl}${postUrl(post.id)}` },
  ],
};

const faqLd =
  data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a },
        })),
      }
    : null;
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={data.cover}
  jsonLd={[articleLd, breadcrumbLd, ...(faqLd ? [faqLd] : [])]}
>
  <article class="post container">
    <nav class="breadcrumb" aria-label="현재 위치">
      <ol>
        <li><a href={withBase('/')}>홈</a></li>
        <li><a href={categoryUrl(category.slug)}>{category.label}</a></li>
        <li aria-current="page">{data.title}</li>
      </ol>
    </nav>

    <h1 class="post__title">{data.title}</h1>

    <div class="post__meta">
      <a class="badge" href={categoryUrl(category.slug)}>{category.label}</a>
      <time datetime={data.pubDate.toISOString()}>{dateText}</time>
      {updatedText && <span>수정 {updatedText}</span>}
      <span>약 {readingMinutes}분</span>
      {isFresh && <span class="badge badge--accent">최신</span>}
    </div>

    <p class="post__lead">{data.description}</p>

    <div class="summary-box">
      <p class="summary-box__title">
        <span aria-hidden="true">✓</span> 3초 요약
      </p>
      <ul>
        {data.summary.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <Toc headings={headings} />

    {showAffiliate && <AffiliateBox placement="top" title="이 글에서 바로 확인할 수 있는 것" compact={false} />}

    <div class="post__body">
      <div>
        <AdSlot slot="top" />

        <div class="prose">
          <slot />
        </div>

        {/* 본문이 끝난 지점의 광고 슬롯(중간). 앞쪽 상단 슬롯과 함께 2개가 본문 구간에 들어갑니다. */}
        <AdSlot slot="mid" />

        {showAffiliate && (
          <AffiliateBox
            placement="bottom"
            title="직접 가격·견적 확인하기"
            body="아래 링크는 이 글에서 비교한 항목을 실제로 확인할 수 있는 제휴 링크입니다. 구매 전 최소 2곳 이상 가격을 비교하세요."
          />
        )}

        {
          showCalculator && (
            <CtaBox
              title="내 차 등록비, 정확히 얼마일까?"
              description="차량가·배기량·지역만 넣으면 취득세, 공채 할인, 등록면허세까지 한 번에 계산됩니다."
            />
          )
        }

        <AdSlot slot="bottom" />

        <InstaBox keyword={data.instaKeyword} />

        {
          data.faq.length > 0 && (
            <section class="faq" aria-labelledby="faq-title">
              <h2 id="faq-title">자주 묻는 질문</h2>
              {data.faq.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))}
            </section>
          )
        }

        {data.tags.length > 0 && (
          <ul class="tag-list" aria-label="태그">
            {data.tags.map((tag) => (
              <li><span>#{tag}</span></li>
            ))}
          </ul>
        )}

        {
          config.affiliates.disclosure && config.showAffiliates && (
            <p class="disclosure">
              <strong>대가성 고지</strong> — {config.affiliates.disclosure}
            </p>
          )
        }

        <p class="disclosure">
          이 글은 {dateText} 기준 공개 자료와 실제 견적을 바탕으로 작성했습니다. 세율·보험료·부품가는
          이후 바뀔 수 있으므로 계약·신고 전 관할 기관과 정비소에서 최종 확인하세요. 본 내용은 세무·법률
          자문이 아닙니다.
        </p>

        <RelatedPosts current={post} posts={related} />
      </div>

      <Toc headings={headings} sticky />
    </div>
  </article>
</BaseLayout>
